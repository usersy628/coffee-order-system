# Copy this file to .env before starting compose.yaml.
# Gradle and IntelliJ do not load .env automatically. Give the local app process
# the same MYSQL_* values described in README.md when it starts with profile local.
# These are deterministic development-only values, not production credentials.
MYSQL_PORT=3306
MYSQL_DATABASE=coffee_order
MYSQL_USER=coffee
MYSQL_PASSWORD=coffee-local
MYSQL_ROOT_PASSWORD=root-local
